{{> main}}

<table width="100%" cellpadding="0" cellspacing="0" style="font-family: Arial, Helvetica, sans-serif; background-color: #ffffff; padding: 20px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" style="max-width: 600px;">
        <tr>
          <td style="padding: 40px 20px; text-align: center;">
            <h1 style="color: #121212; font-size: 24px; font-weight: 700; margin-bottom: 10px;">
              Your Niibow Verification Code
            </h1>
            <p style="color: #555555; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
              We received a request to verify your Niibow account.
              Please use the One-Time Password (OTP) below to continue.
            </p>

            <div style="background-color: #f5f5f5; border-radius: 8px; padding: 20px; display: inline-block; margin: 20px 0;">
              <h2 style="color: #121212; font-size: 32px; font-weight: 700; letter-spacing: 4px; margin: 0;">
                {{{ otp }}}
              </h2>
            </div>

            <p style="color: #555555; font-size: 15px; line-height: 1.6; margin-top: 20px;">
              This code will expire in <strong>30 minutes</strong>.
              If you did not request this, please ignore this message or contact our support team immediately.
            </p>

            <p style="color: #999999; font-size: 13px; line-height: 1.5; margin-top: 40px;">
              Thank you for using Niibow!<br/>
              — The Niibow Team
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

{{> footer}}
